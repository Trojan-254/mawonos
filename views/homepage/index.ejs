    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Pacifico&display=swap');
        
        body {
            font-family: 'Montserrat', sans-serif;
        }
        
        .logo-font {
            font-family: 'Pacifico', cursive;
        }
        
        .coastal-pattern {
            background-image: repeating-linear-gradient(
                45deg,
                #0ea5e9 0px,
                #0ea5e9 15px,
                #f59e0b 15px,
                #f59e0b 30px,
                #f43f5e 30px,
                #f43f5e 45px
            );
        }
        
        .product-card {
            transform: translateY(0);
            transition: all 0.4s ease;
        }
        
        .product-card:hover {
            transform: translateY(-8px);
        }
        
        .category-button {
            transition: all 0.3s ease;
        }
        
        .category-button:hover {
            transform: translateY(-3px);
        }

        .hero-section {
            background-size: cover;
            background-position: center;
            position: relative;
            transition: background-image 1s ease-in-out;
        }

        .hero-bg-1 { background-image: url('./images/chair.jpg'); }
        .hero-bg-2 { background-image: url('./images/table.jpeg'); }
        .hero-bg-3 { background-image: url('./images/storage.jpeg'); }
        .hero-bg-4 { background-image: url('./images/study-table.jpg'); }
        .hero-bg-5 { background-image: url('./images/pallete-bed-3.jpg'); }

        /* Carousel Styles */
        .swiper {
            width: 100%;
            height: 100%;
            margin-left: auto;
            margin-right: auto;
        }
        
        .swiper-pagination-bullet-active {
            background-color: #0ea5e9  !important;
        }
        
        .swiper-button-next,
        .swiper-button-prev {
            color: #0ea5e9  !important;
        }
    </style>
</head>
