    <script>
        // Hero Background Carousel
        document.addEventListener('DOMContentLoaded', function() {
            const heroSection = document.getElementById('heroSection');
            const bgClasses = ['hero-bg-1', 'hero-bg-2', 'hero-bg-3', 'hero-bg-4', 'hero-bg-5'];
            let currentBgIndex = 0;

            function changeHeroBackground() {
                heroSection.classList.remove(bgClasses[currentBgIndex]);
                currentBgIndex = (currentBgIndex + 1) % bgClasses.length;
                heroSection.classList.add(bgClasses[currentBgIndex]);
            }

            // Change background every 5 seconds
            setInterval(changeHeroBackground, 5000);
        });

        // Mobile menu toggle
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuButton = document.querySelector('.md\\:hidden button');
            const mobileMenu = document.createElement('div');
            mobileMenu.className = 'mobile-menu fixed inset-0 bg-black/50 z-50 transform translate-x-full transition-transform duration-300';
            mobileMenu.innerHTML = `
                <div class="bg-white h-full max-w-xs ml-auto p-6 flex flex-col">
                    <div class="flex justify-between items-center mb-6">
                        <span class="logo-font text-2xl text-rose-600">Munric Arts</span>
