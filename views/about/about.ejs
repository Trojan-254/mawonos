        .timeline-item {
            position: relative;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: 14px;
            top: 0;
            height: 100%;
            width: 2px;
            background-color: #f43f5e;
        }

        .timeline-item:last-child::before {
            height: 50%;
        }

        .timeline-marker {
            position: absolute;
            left: 0;
            top: 0;
            height: 30px;
            width: 30px;
            border-radius: 50%;
            background-color: #f43f5e;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            z-index: 10;
        }

        .values-card {
            transition: all 0.3s ease;
        }
        
        .values-card:hover {
            transform: translateY(-5px);
        }
    </style>
