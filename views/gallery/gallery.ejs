        body {
            font-family: 'Montserrat', sans-serif;
        }
        
        .logo-font {
            font-family: 'Pacifico', cursive;
        }
        
        .gallery-card {
            transform: translateY(0);
            transition: all 0.4s ease;
            overflow: hidden;
        }
        
        .gallery-card:hover {
            transform: translateY(-8px);
        }
        
        .gallery-card img {
            transition: transform 0.5s ease;
        }
        
        .gallery-card:hover img {
            transform: scale(1.05);
        }
        
        .category-button {
            transition: all 0.3s ease;
        }
        
        .category-button.active {
            background-color: #e11d48;
            color: white;
        }
        
        .category-button:hover {
            transform: translateY(-3px);
        }

        .hero-section {
            background-size: cover;
            background-position: center;
            position: relative;
            transition: background-image 1s ease-in-out;
        }

        .gallery-hero-bg-1 { background-image: url('./images/chair.jpg'); }
        .gallery-hero-bg-2 { background-image: url('./images/table.jpeg'); }
        .gallery-hero-bg-3 { background-image: url('./images/storage.jpeg'); }
        .gallery-hero-bg-4 { background-image: url('./images/study-table.jpg'); }
        .gallery-hero-bg-5 { background-image: url('./images/pallete-bed-3.jpg'); }

